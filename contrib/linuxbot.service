# Copia in /etc/systemd/system/linuxbot.service, poi:
#   systemctl daemon-reload && systemctl enable --now linuxbot
# Ricarica la configurazione senza disconnettere: systemctl reload linuxbot
[Unit]
Description=The Linux Bot (IRC)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=linuxbot
WorkingDirectory=/opt/the-linux-bot
# Le password possono stare qui invece che nel file YAML
EnvironmentFile=-/etc/linuxbot.env
ExecStart=/opt/the-linux-bot/.venv/bin/python -m linuxbot -c /opt/the-linux-bot/config.yaml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
